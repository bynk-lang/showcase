suite shop.payment

case "a charge that leaves out the currency is taken in pounds" {
	let a <- authorise.call(Charge { pence: 10_000 })
	expect a == Authorisation { approved: true, method: "card" }
}

case "a charge over £100 is declined" {
	let a <- authorise.call(Charge { pence: 10_001 })
	expect !a.approved
}

case "a charge in another currency is declined" {
	let a <- authorise.call(Charge { pence: 500, currency: "EUR" })
	expect !a.approved
}
