---
With `[test] postgres = "pglite"`, `Main` is a real Postgres for each case,
started from `schema.sql`, so the statements run for real: the `CHECK`, the
foreign key and the transaction's rollback all happen in the database. A `stub`
still answers first, which is how a case forces an outage.
---
suite depot.stock

--- A count read back with `firstAs`, a row type only this suite needs.
type Counted = {
	n: Int,
}

case "a fresh database has no stock" {
	let r <- depot.GET("/stock") by Visitor
	expect r == Ok([])
}

case "a restocked SKU reads back as an Item" {
	let set <- depot.PUT("/stock/:sku", "tea", Restock { qty: 2 }) by Visitor
	expect set is NoContent
	let r <- depot.GET("/stock") by Visitor
	expect r == Ok([Item { sku: "tea", qty: 2 }])
}

case "an order takes one from stock" {
	let _ <- depot.PUT("/stock/:sku", "tea", Restock { qty: 1 }) by Visitor
	let ordered <- depot.POST("/orders/:sku", "tea") by Visitor
	expect ordered is Created(_)
	let r <- depot.GET("/stock") by Visitor
	expect r == Ok([Item { sku: "tea", qty: 0 }])
}

case "an order that would go below zero rolls back whole" {
	let _ <- depot.PUT("/stock/:sku", "tea", Restock { qty: 1 }) by Visitor
	let _ <- depot.POST("/orders/:sku", "tea") by Visitor
	let again <- depot.POST("/orders/:sku", "tea") by Visitor
	expect again is Conflict(_)
	let orders <- Main.firstAs[Counted]("FROM (SELECT count(*) AS n FROM orders) AS c", [])
	expect orders == Ok(Some(Counted { n: 1 }))
}

case "an unknown SKU can't be ordered" {
	let r <- depot.POST("/orders/:sku", "coffee") by Visitor
	expect r is Conflict(_)
}

case "an outage is a plain 500, not a crash" {
	stub Main.all(_, _) returns Err(PgConnection("ECONNREFUSED"))
	let r <- depot.GET("/stock") by Visitor
	expect r is ServerError(_)
}
