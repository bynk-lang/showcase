// At the unit tier the handler runs in process: the auth seam is skipped, and a
// case supplies the claims a verified token would carry. The seam itself, the
// signature, `iss`, `aud` and `exp` checks, is tested in `seam.bynk`.
suite ci.release {
	case "a release from the trusted repository" {
		let r <- release.POST(
			"/release"
		) by Workload("wid", TokenClaims.of(["repository: acme/money"]))
		expect r == Ok("released by wid")
	}

	case "a job from another repository is forbidden" {
		let r <- release.POST(
			"/release"
		) by Workload("wid", TokenClaims.of(["repository: evil/fork"]))
		expect r is Forbidden
	}

	case "a token with no repository claim is forbidden" {
		let r <- release.POST("/release") by Workload("wid")
		expect r is Forbidden
	}
}
