// At `system` each call goes through the deployable Worker's real `Oidc` seam.
// The driver is the issuer: it generates a key pair, answers the Worker's fetch
// of the actor's `jwks` URL, and mints the token each call presents. Only the
// test module holds that key, so nothing in the deployed Worker trusts it.
// A token the seam refuses is a `401` before the handler runs, so it reads as
// `Rejected(Unauthorized)`; the handler's own `403` reads as plain `Forbidden`.
suite ci.release as system {
	case "a valid token from the trusted repository is admitted" {
		let r <- release.POST(
			"/release"
		) by Workload("wid", TokenClaims.of(["repository: acme/money"]))
		expect r == Ok("released by wid")
	}

	case "a valid token from another repository passes the seam, then is forbidden" {
		let r <- release.POST(
			"/release"
		) by Workload("wid", TokenClaims.of(["repository: evil/fork"]))
		expect r is Forbidden
	}

	case "tokens the seam must refuse never reach the handler" {
		let none <- release.POST("/release") by Nobody
		let forged <- release.POST("/release") by Forged
		let expired <- release.POST("/release") by Expired
		let wrongIss <- release.POST("/release") by WrongIssuer
		let wrongAud <- release.POST("/release") by WrongAudience
		expect none is Rejected(Unauthorized)
		expect forged is Rejected(Unauthorized)
		expect expired is Rejected(Unauthorized)
		expect wrongIss is Rejected(Unauthorized)
		expect wrongAud is Rejected(Unauthorized)
	}

	case "algorithm confusion and an unusable subject are refused" {
		// Each principal sends both its tokens in turn. The call is `Rejected` only
		// if every one is; if the seam admits any, `r` is that outcome instead.
		// `alg: none`, and an HS256 token keyed with the JWKS public key
		let alg <- release.POST("/release") by WrongAlgorithm
		// an empty `sub` (`WorkloadId` is `NonEmpty`) and a missing one (no identity)
		let sub <- release.POST("/release") by NoSubject
		expect alg is Rejected(Unauthorized)
		expect sub is Rejected(Unauthorized)
	}
}
