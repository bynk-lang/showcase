// At `system` the schedule fires through the deployed Worker's real `scheduled`
// entry point. A `stub` isn't allowed here, so these cases drive only the sweep,
// which never calls `Fetch`, and read its effect back over HTTP. Adding a target
// goes through the real auth seam: `by Operator("ops")` is signed into a JWT,
// and `by Nobody` sends no token at all.
suite uptime.monitor as system {
	env {
		OPS_JWT_SECRET = "test-secret"
	}

	case "one sweep retires a target quiet for a day and keeps a newer one" {
		advance Clock by 3.hours
		let _ <- api.POST("/targets", NewTarget {
			name: "blog",
			url: "https://blog.test",
		}) by Operator("ops")
		advance Clock by 5.minutes
		let _ <- api.POST("/targets", NewTarget {
			name: "shop",
			url: "https://shop.test",
		}) by Operator("ops")
		// 03:00 on day 1: exactly a day after `blog` was added, five minutes short for `shop`
		let r <- jobs.schedule("0 3 * * *", 97200000)
		expect r is Ok(_)
		let blog <- api.GET("/targets/:name", "blog") by Visitor
		expect blog is NotFound
		let shop <- api.GET("/targets/:name", "shop") by Visitor
		expect shop is Ok(_)
	}

	case "with nothing to watch the sweep has nothing to do" {
		let r <- jobs.schedule("0 3 * * *", 97200000)
		expect r is Ok(_)
	}

	case "adding a target without an operator token is refused" {
		let r <- api.POST("/targets", NewTarget {
			name: "metadata",
			url: "http://169.254.169.254",
		}) by Nobody
		expect r is Rejected(Unauthorized)
	}
}
