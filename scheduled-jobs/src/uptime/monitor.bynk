context uptime.monitor

uses uptime.policy
consumes bynk { Clock, Fetch, Logger, TimedOut }

type Name = String where NonEmpty && MaxLength(40)

--- Only `http` and `https` URLs. `Matches` is anchored, so the whole string must fit.
type Url = String where Matches("https?://.+")

type OperatorId = String where NonEmpty

---
Whoever runs the monitor: a JWT verified at the boundary. A missing, forged or
expired token is a `401` before any handler runs.
---
actor Operator { auth = Bearer(secret = "OPS_JWT_SECRET"), identity = OperatorId }

--- What the last probe of a target found.
type Probe =
	| Unchecked
	| Answered(status: Int)
	| Unreachable

type Target = {
	name: Name,
	url: Url,
	last: Probe,
	--- When the target last answered healthily, or when it was added if it never has.
	seenUp: Instant,
}

--- What a caller sends to start watching a URL.
type NewTarget = {
	name: Name,
	url: Url,
}

---
Every handler works on the one watchlist, so its key is a fixed name rather
than anything a caller chooses.
---
const Everything: String = "all"

---
How long one probe may wait for an answer. A target that hangs is recorded as
`Unreachable` instead of holding up the run.
---
const ProbeBudget: Duration = 10.seconds

agent Watchlist {
	key id: String

	store targets: Map[Name, Target]

	---
	Start watching `t`, unless its name is taken. Refusing a duplicate means no
	one can swap another target's URL or reset its `seenUp` by adding it again.
	---
	on call add(t: Target) -> Effect[Bool] {
		let found <- targets.get(t.name)
		match found {
			Some(_) => false,
			None => {
				do targets.put(t.name, t)
				true
			},
		}
	}

	--- Stop watching `name`. Says whether it was being watched.
	on call drop(name: Name) -> Effect[Bool] {
		let found <- targets.get(name)
		match found {
			None => false,
			Some(_) => {
				do targets.remove(name)
				true
			},
		}
	}

	on call find(name: Name) -> Effect[Option[Target]] {
		targets.get(name)
	}

	on call all() -> Effect[List[Target]] {
		targets.sortBy((t) => t.name).collect()
	}

	--- Note a probe's result. Only a healthy answer moves `seenUp` on.
	on call observe(name: Name, probe: Probe, at: Instant) -> Effect[()] {
		let found <- targets.get(name)
		match found {
			None => (),
			Some(t) => {
				let up = match probe {
					Answered(status) => isHealthy(status),
					_ => false,
				}
				let seenUp = if up { at } else { t.seenUp }
				do targets.put(name, Target { ...t, last: probe, seenUp: seenUp })
			},
		}
	}

	--- Stop watching every target that has been quiet too long, and say which.
	on call retire(now: Instant) -> Effect[List[Name]] {
		let gone <- targets.filter((t) => isAbandoned(t.seenUp, now)).map((t) => t.name).collect()
		do gone.forEach((n) => {
			do targets.remove(n)
		})
		gone
	}
}

---
Two schedules, one service. Nothing calls these handlers: the platform fires
them, so there is no caller to answer and no principal. Each handler takes
`at`, the schedule-aligned fire time in epoch milliseconds, and turns it into
an `Instant` straight away.
---
service jobs from cron {
	---
	Every five minutes, probe each target. The probes don't depend on each other,
	so `parTraverse` sends them together: the run costs the slowest probe, not the
	sum, and each is bounded by `ProbeBudget`. An upstream that is down or too slow
	is a result to record, not a failed run, so it becomes `Unreachable` and the
	run still returns `Ok`.

	Two limits to know before watching hundreds of targets: `parTraverse` starts
	every probe at once, and Workers cap simultaneous outbound connections; and
	each probe records its own result, one call into `Watchlist` per target.
	Batching would mean collecting the results and recording them in one call.
	---
	on schedule("*/5 * * * *") (at: Int) -> Effect[Result[(), String]] given Fetch {
		let now = Instant.fromEpochMillis(at)
		let targets <- Watchlist(Everything).all()
		do targets.parTraverse((t) => {
			let res <- Fetch.send(Request {
				method: Get,
				url: t.url,
				contentType: None,
				authorization: None,
				headers: Map.empty(),
				body: None,
			}).within(ProbeBudget)
			// A timeout stops the wait, not the request: the abandoned call runs on.
			let probe = match res {
				Ok(Ok(r)) => Answered(r.status),
				Ok(Err(_)) => Unreachable,
				Err(TimedOut { .. }) => Unreachable,
			}
			do Watchlist(Everything).observe(t.name, probe, now)
		})
		Ok(())
	}

	---
	At 03:00 each day, retire targets with no healthy answer for `GiveUpAfter`.
	The cut-off is measured from the scheduled time, not from when the run
	happens to start, so a late start doesn't move it.
	---
	on schedule("0 3 * * *") (at: Int) -> Effect[Result[(), String]] given Logger {
		let gone <- Watchlist(Everything).retire(Instant.fromEpochMillis(at))
		do gone.forEach((n) => {
			do Logger.info("stopped watching \(n)")
		})
		Ok(())
	}
}

---
Add a target and read it back. The HTTP side is small, but it is how anyone
sees what the jobs did, and it lets a `system` suite drive the real Worker.
---
service api from http {
	---
	Only an operator may add a target. The cron fetches every URL it is given, so
	an open route would let anyone point it at internal hosts. The guard limits
	who chooses the URLs; it doesn't check where they point. A name that is
	already watched is a `409`, never a replacement.
	---
	on POST("/targets") (body: NewTarget) -> Effect[HttpResult[Target]] by Operator given Clock {
		let now <- Clock.now()
		let t = Target {
			name: body.name,
			url: body.url,
			last: Unchecked,
			seenUp: now,
		}
		let added <- Watchlist(Everything).add(t)
		if added { Created(t) } else { Conflict("\(body.name) is already watched") }
	}

	---
	Only an operator may stop watching a target. With no replacement on `POST`,
	this is how a target added with the wrong URL is fixed: remove it, then add
	it again.
	---
	on DELETE("/targets/:name") (name: Name) -> Effect[HttpResult[String]] by Operator {
		let dropped <- Watchlist(Everything).drop(name)
		if dropped { NoContent } else { NotFound }
	}

	on GET("/targets/:name") (name: Name) -> Effect[HttpResult[Target]] by Visitor {
		let found <- Watchlist(Everything).find(name)
		match found {
			Some(t) => Ok(t),
			None => NotFound,
		}
	}
}
