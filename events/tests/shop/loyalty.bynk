---
The subscriber's side. `AwardPoints.event(e)` delivers one event through the
service's generated handler, the path the fan-out uses, so the header's
pattern filter applies. No checkout is involved.
---
suite shop.loyalty

--- A £25.99 order from ada, numbered `id`.
fn order(id: String, region: Region) -> OrderPlaced {
	OrderPlaced {
		orderId: id,
		customer: "ada",
		region: region,
		totalPence: 2599,
	}
}

case "a domestic order earns a point per whole pound" {
	let _ <- AwardPoints.event(order("o-1", Region.Domestic))
	let points <- Points("ada").current()
	expect points == 25
}

case "an international order is filtered out before the handler runs" {
	let _ <- AwardPoints.event(order("o-1", Region.International))
	let points <- Points("ada").current()
	expect points == 0
}

case "the same order earns nothing the second time" {
	// Each delivery here gets a fresh `eventId`, as a resubmitted checkout's
	// second emission would. A redelivery repeats the `eventId` too, but the
	// handler never reads it: the `orderId` is the same, so it is one award.
	let _ <- AwardPoints.event(order("o-1", Region.Domestic))
	let _ <- AwardPoints.event(order("o-1", Region.Domestic))
	let points <- Points("ada").current()
	expect points == 25
}

case "two different orders are two awards" {
	let _ <- AwardPoints.event(order("o-1", Region.Domestic))
	let _ <- AwardPoints.event(order("o-2", Region.Domestic))
	let points <- Points("ada").current()
	expect points == 50
}
