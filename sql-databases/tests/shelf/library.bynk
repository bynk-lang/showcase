suite shelf.library

fn dune() -> NewBook {
	NewBook {
		isbn: "9780441013593",
		title: "Dune",
		author: "Frank Herbert",
		pages: 412,
	}
}

fn solaris() -> NewBook {
	NewBook {
		isbn: "9780156027601",
		title: "Solaris",
		author: "Stanisław Lem",
		pages: 204,
	}
}

case "a fresh database already has the migrated schema" {
	let unread <- api.GET("/unread") by Visitor
	expect unread is Ok([])
}

case "select reads rows into Book, firstAs one row" {
	let _ <- api.POST("/books", dune()) by Visitor
	let _ <- api.POST("/books", solaris()) by Visitor
	let unread <- api.GET("/unread") by Visitor
	expect unread is Ok([Book { title: "Solaris", .. }, Book { title: "Dune", .. }])
	let one <- api.GET("/books/:isbn", "9780441013593") by Visitor
	expect one is Ok(Book { author: "Frank Herbert", finished: false, .. })
	let none <- api.GET("/books/:isbn", "0000000000") by Visitor
	expect none is NotFound
}

case "a finished book leaves the unread list, and reads back as true" {
	let _ <- api.POST("/books", dune()) by Visitor
	let _ <- api.POST("/books", solaris()) by Visitor
	let done <- api.POST("/books/:isbn/finished", "9780156027601") by Visitor
	expect done is NoContent
	let unread <- api.GET("/unread") by Visitor
	expect unread is Ok([Book { title: "Dune", .. }])
	let read <- api.GET("/books/:isbn", "9780156027601") by Visitor
	expect read is Ok(Book { finished: true, .. })
	let missing <- api.POST("/books/:isbn/finished", "0000000000") by Visitor
	expect missing is NotFound
}

case "a second book with the same ISBN is a conflict" {
	let first <- api.POST("/books", dune()) by Visitor
	expect first is Created(_)
	let again <- api.POST("/books", dune()) by Visitor
	expect again is Conflict(_)
}

// A case holds the same `Books` the handlers use, so the cases below reach
// under the service.
case "the table's CHECKs refuse a row Book would refuse" {
	let r <- Books.run(
		"INSERT INTO books (isbn, title, author, pages) VALUES ('x', 'Notes', 'Anon', 0)",
		[]
	)
	expect r is Err(Constraint(_))
}

// The migration's table can't hold a row `Book` refuses, so this case swaps in
// a loose one, as if the schema had drifted from the record. `bynk check`
// prepares each statement against the migrated schema on its own, where
// `books` still exists; `IF NOT EXISTS` lets the CREATE prepare there, and by
// the time it runs the DROP has cleared the way.
case "a row that does not fit Book is a Decode error, logged and hidden" {
	let swapped <- Books.batch([
		SqlStatement {
			sql: "DROP TABLE books",
			params: [],
		},
		SqlStatement {
			sql: "CREATE TABLE IF NOT EXISTS books (isbn, title, author, pages, finished)",
			params: [],
		},
		SqlStatement {
			sql: "INSERT INTO books VALUES ('x', 'Notes', 'Anon', 10, 2)",
			params: [],
		},
	])
	expect swapped is Ok(_)
	let r <- api.GET("/books/:isbn", "x") by Visitor
	expect r is ServerError("the reading list is unavailable")
	expect Logger.error called once with msg.startsWith("a books row did not fit Book: StructuralMismatch at $.finished")
}

case "a statement the database refuses is a Sql error, logged and hidden" {
	let dropped <- Books.run("DROP TABLE books", [])
	expect dropped is Ok(_)
	let r <- api.GET("/unread") by Visitor
	expect r is ServerError("the reading list is unavailable")
	expect Logger.error called once with msg.startsWith("books query failed: ")
}
