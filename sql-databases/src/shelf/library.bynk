context shelf.library

uses shelf.books
consumes bynk { Logger }
consumes bynk.cloudflare { D1 }

---
The reading list's database. It binds as `env.D1_BOOKS` and is named
`shelf-library-books`, the name its `migrations/` directory carries.
---
capability Books = D1

---
A failed statement's details name tables and columns, so they go to the log and
the caller gets this.
---
fn unavailable() -> String {
	"the reading list is unavailable"
}

service api from http {
	---
	Add a book, unread: the column's `DEFAULT 0` fills `finished`. A second book
	with the same ISBN breaks the primary key, which is a `Conflict`.
	---
	on POST("/books") (body: NewBook) -> Effect[HttpResult[Book]] by Visitor given Books, Logger {
		let added <- Books.run(
			"""sql
			INSERT INTO books (isbn, title, author, pages)
			VALUES (?1, ?2, ?3, ?4)
			""",
			[Text(body.isbn), Text(body.title), Text(body.author), Integer(body.pages)]
		)
		match added {
			Ok(_) => Created(Book {
				isbn: body.isbn,
				title: body.title,
				author: body.author,
				pages: body.pages,
				finished: false,
			}),
			Err(Constraint(_)) => Conflict("that ISBN is already on the shelf"),
			Err(e) => {
				do Logger.error(sqlReason(e))
				ServerError(unavailable())
			},
		}
	}

	--- One book, or `NotFound`.
	on GET("/books/:isbn") (isbn: Isbn) -> Effect[HttpResult[Book]] by Visitor given Books, Logger {
		let found <- Books.firstAs[Book]("FROM books WHERE isbn = ?1", [Text(isbn)])
		match found {
			Ok(Some(book)) => Ok(book),
			Ok(None) => NotFound,
			Err(Sql(e)) => {
				do Logger.error(sqlReason(e))
				ServerError(unavailable())
			},
			Err(Decode(e)) => {
				do Logger.error(rowReason(e))
				ServerError(unavailable())
			},
		}
	}

	--- The books still to read, shortest first.
	on GET("/unread") () -> Effect[HttpResult[List[Book]]] by Visitor given Books, Logger {
		let rows <- Books.select[Book](
			"""sql
			FROM books
			WHERE finished = 0
			ORDER BY pages, title
			""",
			[]
		)
		match rows {
			Ok(list) => Ok(list),
			Err(Sql(e)) => {
				do Logger.error(sqlReason(e))
				ServerError(unavailable())
			},
			Err(Decode(e)) => {
				do Logger.error(rowReason(e))
				ServerError(unavailable())
			},
		}
	}

	--- Mark a book read. An `UPDATE` that changed no row means there was no such book.
	on POST("/books/:isbn/finished") (
		isbn: Isbn
	) -> Effect[HttpResult[()]] by Visitor given Books, Logger {
		let r <- Books.run("UPDATE books SET finished = 1 WHERE isbn = ?1", [Text(isbn)])
		match r {
			Ok(run) => if run.changes == 0 { NotFound } else { NoContent },
			Err(e) => {
				do Logger.error(sqlReason(e))
				ServerError(unavailable())
			},
		}
	}
}

---
A row that did not fit `Book`. In `Err(Decode(e))`, `e` is a `DecodeError`, so its
fields say which column was wrong and why.
---
fn rowReason(e: DecodeError) -> String {
	"a books row did not fit Book: \(e.kind) at \(e.path): \(e.message)"
}

--- `SqlError` is extensible, so the match keeps a wildcard.
fn sqlReason(e: SqlError) -> String {
	match e {
		Constraint(message) => "books constraint: \(message)",
		Failed(message) => "books query failed: \(message)",
		_ => "books query failed",
	}
}
