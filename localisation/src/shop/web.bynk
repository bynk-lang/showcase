context shop.web

uses bynk.locale.types
uses shop.messages
consumes bynk { Locale }

---
The query string of `GET /basket`, such as `?items=3`.
---
type BasketQuery = {
	items: ItemCount,
}

service api from http {
	---
	The handler never parses `Accept-Language` itself. It asks `Locale`, and
	on Cloudflare the platform negotiates the header against the locales
	`shop.messages` declares, falling back to its reference locale.
	---
	on GET("/basket") (query: BasketQuery) -> Effect[HttpResult[String]] by Visitor given Locale {
		let tag <- Locale.current()
		Ok(basketSummary(tag, query.items))
	}
}
