suite weather.api

// The handler only knows `Forecasts`, so most cases stub that one seam and
// never go near the network. `expect Fetch.send never called` proves it.

case "a cold day comes with advice" {
	stub Forecasts.today(_) returns Ok(Forecast { city: "oslo", highC: 2, summary: "snow showers" })
	let r <- api.GET("/forecast/:city", "oslo") by Visitor
	expect r == Ok("oslo: 2°C, snow showers. Wrap up warm.")
	expect Forecasts.today called once
	expect Fetch.send never called
}

case "a mild day is just the forecast" {
	stub Forecasts.today(_) returns Ok(Forecast { city: "london", highC: 14, summary: "light rain" })
	let r <- api.GET("/forecast/:city", "london") by Visitor
	expect r == Ok("london: 14°C, light rain.")
}

case "an unknown city is not found" {
	stub Forecasts.today(_) returns Err(UnknownCity)
	let r <- api.GET("/forecast/:city", "atlantis") by Visitor
	expect r is NotFound
}

case "an unavailable forecast is logged and reported as 503" {
	stub Forecasts.today(_) returns Err(Unavailable)
	let r <- api.GET("/forecast/:city", "paris") by Visitor
	expect r is ServiceUnavailable(_)
	expect Logger.warn called once with msg == "forecast unavailable for paris"
}

case "a badly spelt city is rejected before any capability is used" {
	let r <- api.GET("/forecast/:city", "New York") by Visitor
	expect r is BadRequest(_)
	expect Forecasts.today never called
}

case "a stray hyphen is rejected too" {
	let r <- api.GET("/forecast/:city", "london-") by Visitor
	expect r is BadRequest(_)
}

// Leave `Forecasts` unstubbed and the real `HttpForecasts` provider runs,
// composed over the platform doubles. Stub those instead to test it offline.

--- An upstream answer with this status and body.
fn answer(status: Int, body: String) -> Response {
	Response {
		status: status,
		headers: Map.empty(),
		body: body,
	}
}

case "the provider builds the URL from the configured base" {
	stub Secrets.get("FORECAST_API_URL") returns Some("https://forecast.test")
	stub Fetch.send(_) returns Ok(answer(200, "{\"city\":\"new-york\",\"highC\":21,\"summary\":\"sunny\"}"))
	let r <- api.GET("/forecast/:city", "new-york") by Visitor
	expect r == Ok("new-york: 21°C, sunny.")
	expect Fetch.send called once with req.url == "https://forecast.test/today/new-york"
}

case "the provider maps an upstream 404 to an unknown city" {
	stub Secrets.get(_) returns Some("https://forecast.test")
	stub Fetch.send(_) returns Ok(answer(404, ""))
	let r <- api.GET("/forecast/:city", "atlantis") by Visitor
	expect r is NotFound
}

case "the provider treats an unreadable body as unavailable" {
	stub Secrets.get(_) returns Some("https://forecast.test")
	stub Fetch.send(_) returns Ok(answer(200, "not json"))
	let r <- api.GET("/forecast/:city", "london") by Visitor
	expect r is ServiceUnavailable(_)
	expect Logger.warn called once
}

case "an unconfigured provider never calls out" {
	let r <- api.GET("/forecast/:city", "london") by Visitor
	expect r is ServiceUnavailable(_)
	expect Fetch.send never called
}
